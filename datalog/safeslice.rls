@import hasIngredient :- csv { resource = "../data/dish_ingredients.csv", ignore_headers = true } .
@import hasBase :- csv { resource = "../data/bases.csv", ignore_headers = true } .
@import madeFrom :- csv { resource = "../data/madefrom.csv", ignore_headers = true } .
@import category :- csv { resource = "../data/categories.csv", ignore_headers = true } .
@import forbids :- csv { resource = "../data/restrictions.csv", ignore_headers = true } .
@import customerRestriction :- csv { resource = "../data/customers.csv", ignore_headers = true } .
@import dishType :- csv { resource = "../data/dish_types.csv", ignore_headers = true } .
@import ingredientType :- csv { resource = "../data/ingredient_types.csv", ignore_headers = true } .
@import subTypeOf :- csv { resource = "../data/type_hierarchy.csv", ignore_headers = true } .
@import typeCategory :- csv { resource = "../data/type_categories.csv", ignore_headers = true } .
@import calories :- csv { resource = "../data/dish_calories.csv", ignore_headers = true } .

% Ingredient taxonomy. OWL gets these inferences from subclass reasoning.
% In Datalog the hierarchy is data, so two rules walk it and one rule inherits the categories.
instanceOf(?ingredient, ?type) :- ingredientType(?ingredient, ?type) .
instanceOf(?ingredient, ?parent) :- instanceOf(?ingredient, ?type), subTypeOf(?type, ?parent) .
category(?ingredient, ?tag) :- instanceOf(?ingredient, ?type), typeCategory(?type, ?tag) .

directIngredient(?dish, ?ingredient) :- hasIngredient(?dish, ?ingredient) .
directIngredient(?dish, ?ingredient) :- hasBase(?dish, ?ingredient) .
dish(?dish) :- directIngredient(?dish, ?ingredient) .
menuDish(?dish) :- dish(?dish), ~category(?dish, EvaluationFixture) .
customer(?customer) :- customerRestriction(?customer, ?entry) .
hasRestriction(?customer, ?restriction) :- customerRestriction(?customer, ?restriction), ?restriction != None .

containsIngredient(?dish, ?ingredient) :- directIngredient(?dish, ?ingredient) .
containsIngredient(?dish, ?component) :- containsIngredient(?dish, ?ingredient), madeFrom(?ingredient, ?component) .

violation(?dish, ?restriction, ?ingredient) :-
    containsIngredient(?dish, ?ingredient), category(?ingredient, ?tag), forbids(?restriction, ?tag) .
blocked(?dish, ?restriction) :- violation(?dish, ?restriction, ?ingredient) .
restriction(?restriction) :- forbids(?restriction, ?tag) .
complies(?dish, ?restriction) :-
    category(?dish, CompleteRecipe), dish(?dish), restriction(?restriction), ~blocked(?dish, ?restriction) .
unsafeFor(?dish, ?customer) :- hasRestriction(?customer, ?restriction), blocked(?dish, ?restriction) .
noKnownBlockerFor(?dish, ?customer) :- dish(?dish), customer(?customer), ~unsafeFor(?dish, ?customer) .
safeFor(?dish, ?customer) :- noKnownBlockerFor(?dish, ?customer), category(?dish, CompleteRecipe) .
unknownFor(?dish, ?customer) :- noKnownBlockerFor(?dish, ?customer), ~category(?dish, CompleteRecipe) .
spicyBecause(?dish, ?ingredient) :- containsIngredient(?dish, ?ingredient), category(?ingredient, HotSpicy) .
containsDairy(?dish) :- containsIngredient(?dish, ?ingredient), category(?ingredient, Dairy) .
dairyFree(?dish) :- dish(?dish), category(?dish, CompleteRecipe), ~containsDairy(?dish) .

% Extension: kosher also forbids meat and dairy in the same dish.
% This is a rule about a combination of two categories, so it needs two witnesses.
combinationViolation(?dish, KosherDiet, ?meat, ?dairy) :-
    containsIngredient(?dish, ?meat), category(?meat, Meat),
    containsIngredient(?dish, ?dairy), category(?dairy, Dairy) .
blocked(?dish, KosherDiet) :- combinationViolation(?dish, KosherDiet, ?meat, ?dairy) .

% Counterparts of the OWL classes that use the taxonomy and the constructs beyond ALC.
% CompositeIngredient: an ingredient with at least one stated component.
compositeIngredient(?ingredient) :- madeFrom(?ingredient, ?component) .
% PlantBasedDish: a complete recipe in which nothing is animal sourced (needs negation).
containsAnimalSourced(?dish) :- containsIngredient(?dish, ?ingredient), instanceOf(?ingredient, AnimalSourcedIngredient) .
plantBasedDish(?dish) :- dish(?dish), category(?dish, CompleteRecipe), ~containsAnimalSourced(?dish) .
% SeafoodDish: fish or shellfish at any depth of the recipe (a union needs two rules).
seafoodDish(?dish) :- containsIngredient(?dish, ?ingredient), instanceOf(?ingredient, FishProduct) .
seafoodDish(?dish) :- containsIngredient(?dish, ?ingredient), instanceOf(?ingredient, ShellfishProduct) .
% PizzaIngredient: everything that ends up in some pizza.
pizzaIngredient(?ingredient) :- dishType(?dish, Pizza), containsIngredient(?dish, ?ingredient) .
% MultiRestrictionCustomer: two different restrictions (counting needs an inequality).
multiRestrictionCustomer(?customer) :-
    hasRestriction(?customer, ?first), hasRestriction(?customer, ?second), ?first != ?second .
% SafeForEveryRestrictionDish: a complete menu dish that no restriction blocks.
blockedBySome(?dish) :- blocked(?dish, ?restriction) .
safeForEveryRestriction(?dish) :- menuDish(?dish), category(?dish, CompleteRecipe), ~blockedBySome(?dish) .

% LightDish: a menu dish with at most 600 kcal. The same number is in tools/build_ontology.py.
lightDish(?dish) :- menuDish(?dish), calories(?dish, ?kcal), ?kcal <= 600 .

% Integrity checks. In OWL the matching axioms make the ontology inconsistent when they are broken.
% Datalog has no inconsistency, so each check is a rule that should derive nothing.
% OWL can only forbid a direct loop (madeFrom is irreflexive), because the transitive role
% hasComponent is not simple. Datalog can check loops of any length.
hasComponent(?ingredient, ?part) :- madeFrom(?ingredient, ?part) .
hasComponent(?ingredient, ?part) :- hasComponent(?ingredient, ?middle), madeFrom(?middle, ?part) .
compositionCycle(?ingredient) :- hasComponent(?ingredient, ?ingredient) .
% A pizza has exactly one base, and it is a dough or batter.
hasSomeBase(?dish) :- hasBase(?dish, ?base) .
pizzaBaseProblem(?dish) :- dishType(?dish, Pizza), ~hasSomeBase(?dish) .
pizzaBaseProblem(?dish) :- dishType(?dish, Pizza), hasBase(?dish, ?base), ~instanceOf(?base, DoughOrBatter) .
% hasBase is functional: no dish has two different bases.
twoBases(?dish) :- hasBase(?dish, ?first), hasBase(?dish, ?second), ?first != ?second .
% Ingredient types on the same level are disjoint: no ingredient has two stated types.
twoTypes(?ingredient) :- ingredientType(?ingredient, ?first), ingredientType(?ingredient, ?second), ?first != ?second .

% Q13 compares an explicit hypothetical policy for the two gelatin fixtures.
containsOutsideException(?dish, ?ingredient) :-
    category(?dish, EvaluationFixture), directIngredient(?dish, ?ingredient), ~category(?ingredient, HalalCertified) .
containsOutsideException(?dish, ?component) :-
    containsOutsideException(?dish, ?ingredient), madeFrom(?ingredient, ?component) .
porkOutsideException(?dish) :- containsOutsideException(?dish, ?ingredient), category(?ingredient, Pork) .
halalWithFixtureException(?dish) :-
    category(?dish, EvaluationFixture), category(?dish, CompleteRecipe),
    directIngredient(?dish, ?ingredient), category(?ingredient, HalalCertified), ~porkOutsideException(?dish) .

% Q10 uses an explicit integrity check for the hypothetical vegetarian salami dish.
declaredVegetarianIngredient(VegetarianSalamiDish, Salami) .
integrityViolation(?dish, ?ingredient) :-
    declaredVegetarianIngredient(?dish, ?ingredient), category(?ingredient, ?tag), forbids(VegetarianDiet, ?tag) .

@export menuDish :- csv {} .
@export containsIngredient :- csv {} .
@export violation :- csv {} .
@export complies :- csv {} .
@export safeFor :- csv {} .
@export unsafeFor :- csv {} .
@export unknownFor :- csv {} .
@export noKnownBlockerFor :- csv {} .
@export spicyBecause :- csv {} .
@export dairyFree :- csv {} .
@export halalWithFixtureException :- csv {} .
@export integrityViolation :- csv {} .
@export combinationViolation :- csv {} .
@export instanceOf :- csv {} .
@export compositeIngredient :- csv {} .
@export plantBasedDish :- csv {} .
@export seafoodDish :- csv {} .
@export pizzaIngredient :- csv {} .
@export multiRestrictionCustomer :- csv {} .
@export safeForEveryRestriction :- csv {} .
@export lightDish :- csv {} .
@export compositionCycle :- csv {} .
@export pizzaBaseProblem :- csv {} .
@export twoBases :- csv {} .
@export twoTypes :- csv {} .
